# Copy this file to .env and fill in real values. Never commit .env itself.

RESEND_API_KEY=
CONTACT_EMAIL=contact@nexinsystems.com
GEMINI_API_KEY=

# Canonical URL for this deployment (used to build invite/magic-link
# redirect URLs). http://localhost:3001 in dev; your real domain in
# production (set this on Vercel's production env vars).
SITE_URL=https://nextinnovationsystems.com
# ── Supabase (careers/resumes + employee portal) ──
# Project Settings → API.
SUPABASE_URL=
# service_role secret key — server-only, bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=
# anon/public key — used only for the login/session flow.
SUPABASE_ANON_KEY=
# same URL/anon key again, NEXT_PUBLIC_-prefixed for the browser bundle
# (invite-acceptance page). Safe to expose — protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Hostinger Agentic Mail (employee portal → Mail) ──
# hPanel → Agentic Mail → API → Create API token (scope: all mailboxes).
HOSTINGER_MAIL_API_TOKEN=
